// -*- mode: jsonc -*-
// ~/.config/waybar/config.jsonc
[
    // ==========================================
    // CONFIGURATION FOR LAPTOP DISPLAY (eDP-1)
    // ==========================================
    {

        "output": ["eDP-1"],
        "include": ["~/.config/waybar/modules.jsonc"],
        
        "layer": "top",
        "mod": "dock",
        "passthrough": false,
        "exclusive": true,
        "height": 42,
        "width": 1920,
        "spacing": 20,

        "modules-left": [
            "custom/power",
            "group/pill-backlight",
            "group/pill-left",
            "group/pill-laptop",
            "group/pill-rotate",
            "custom/keyboard"
        ],

    "group/pill#center": { 
        "orientation": "inherit",
        "modules": [
            "clock",
            "hyprland/workspaces"
        ] 
    },
        "modules-center": [
            "group/pill#center"
        ],
        "modules-right": [
            "network",
            "group/pill-memory",
            "sway/language",
            "battery",
            "group/pill-tray"
        ]
    },

    // ==========================================
    // CONFIGURATION FOR EXTERNAL MONITOR (HDMI-A-1)
    // ==========================================
    {
        "output": ["HDMI-A-1"],
        "include": ["~/.config/waybar/modules.jsonc"],
        
        "layer": "top",
        "mod": "dock",
        "passthrough": false,
        "exclusive": true,
        "height": 42, // Edit these values independently for HDMI-A-1
        "width": 2560,
        "spacing": 20,

        "modules-left": [
            "custom/power",
            "group/pill-backlight",
            "group/pill-left",
            "group/pill-laptop",
            "group/pill-rotate",
            "custom/keyboard"
        ],
    "group/pill#center2": { 
        "orientation": "inherit",
        "modules": [
            "clock",
            "hyprland/workspaces"
        ] 
    },
        "modules-center": [
            "group/pill#center2",
            "hyprland/window"
        ],
        "modules-right": [
            "network",
            "group/pill-memory",
            "sway/language",
            "battery",
            "group/pill-tray" // Feel free to delete or change modules just for this screen
        ]
    }
]
