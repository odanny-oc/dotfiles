[
  {
    "layer": "top",
    "output": [
      "DP-1",
      "HDMI-A-1"
    ],
    "position": "top",
    "mod": "dock",
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,

    "include": [
      "$XDG_CONFIG_HOME/waybar/modules/*json*",
      "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],

    "modules-left": [
      "group/pill#left1",
      "group/pill#left2"
    ],

    "group/pill#left1": {
      "orientation": "inherit",
      "modules": [
        "cpu",
        "memory"
      ]
    },

    "group/pill#left2": {
      "orientation": "inherit",
      "modules": [
        "clock"
      ]
    },

    "modules-center": [
      "group/pill#center"
    ],

    "group/pill#center": {
      "orientation": "inherit",
      "modules": [
        "hyprland/workspaces",
        "hyprland/window"
      ]
    },

    "modules-right": [
      "group/pill#right1",
      "group/pill#right2",
      "group/pill#right3"
    ],

    "group/pill#right1": {
      "orientation": "inherit",
      "modules": [
        "pulseaudio",
        "pulseaudio#microphone",
        "custom/keybindhint"
      ]
    },

    "group/pill#right2": {
      "orientation": "inherit",
      "modules": [
        "privacy",
        "tray"
      ]
    },

    "group/pill#right3": {
      "orientation": "inherit",
      "modules": [
        "custom/wbar",
        "custom/cliphist",
        "custom/hyde-menu",
        "custom/power"
      ]
    }
  },

  {
  "layer": "top",
  "output": [
    "DP-2"
  ],

  "position": "top",
  "mod": "dock",
  "height": 10,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,

  "include": [
    "$XDG_CONFIG_HOME/waybar/modules/*json*",
    "$XDG_CONFIG_HOME/waybar/includes/includes.json"
  ],

  "modules-left": [
    "group/pill#left1"
  ],

  "group/pill#left1": {
    "orientation": "inherit",
    "modules": [
      "clock",
      "memory"
    ]
  },

  "modules-center": [
    "group/pill#center"
  ],

  "group/pill#center": {
    "orientation": "inherit",
    "modules": [
      "hyprland/workspaces"
    ]
  },

  "modules-right": [
    "group/pill#right1"
  ],

  "group/pill#right1": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "tray"
    ]
  }
  }
]
